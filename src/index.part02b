atus',!!rec.morning);setStatus('eveningStatus',!!rec.evening);
 const t=validEvents().filter(x=>x.date===todayKey());document.getElementById('todayAnxiety').textContent=t.length;document.getElementById('todayDelay').textContent=t.filter(x=>x.outcome==='delayed').length;document.getElementById('todayCheck').textContent=t.filter(x=>x.outcome==='checked').length;document.getElementById('todayRecovery').textContent=avg(t.map(x=>x.recovery))??'—';
 renderActiveDelay();renderProgress();renderRecords();document.getElementById('startDateInput').value=data.startDate;
}
function setStatus(id,done){const e=document.getElementById(id);e.textContent=done?'已完成':'未完成';e.className='badge '+(done?'':'gray')}
function avg(a){const v=a.map(Number).filter(Number.isFinite);return v.length?Math.round(v.reduce((x,y)=>x+y,0)/v.length):null}
function eventsIn(days,offset=0){const end=parseDay(todayKey());end.setDate(end.getDate()-offset);const start=new Date(end);start.setDate(start.getDate()-days+1);return doneEvents().filter(x=>{const d=parseDay(x.date);return d>=start&&d<=end})}
function metrics(xs){const resolved=xs.filter(x=>['delayed','checked'].includes(x.outcome)),delayed=resolved.filter(x=>x.outcome==='delayed').length;return {anxiety:xs.length,check:xs.filter(x=>x.outcome==='checked').length,delayRate:resolved.length?Math.round(delayed/resolved.length*100):null,recovery:avg(xs.map(x=>x.recovery))}}
function deltaText(curr,prev,lowerBetter=false,suffix=''){if(curr==null||prev==null)return {t:'資料不足',c:'neutral'};if(curr===prev)return {t:'與上週相同',c:'neutral'};const diff=curr-prev,good=lowerBetter?diff<0:diff>0;return {t:`${diff>0?'↑':'↓'} ${Math.abs(diff)}${suffix}`,c:good?'good':'bad'}}
function setDelta(id,o){const e=document.getElementById(id);e.textContent=o.t;e.className='delta '+o.c}
function renderProgress(){
 const dn=dayNum(),pct=Math.round(dn/30*100);document.getElementById('progressText').textContent=`Day ${dn} / 30`;document.getElementById('progressBar').style.width=pct+'%';
 const completed=Object.keys(data.days).filter(completedDay).length;document.getElementById('completionCopy').textContent=`目前有 ${completed} 天完成早晚兩次練習。未完成某一天不算失敗，重點是持續回來。`;
 const dots=document.getElementById('weekDots');dots.innerHTML='';for(let i=6;i>=0;i--){const d=new Date(parseDay(todayKey()));d.setDate(d.getDate()-i);const k=d.toLocaleDateString('sv-SE'),cl=completedDay(k)?'done':partialDay(k)?'partial':'';dots.insertAdjacentHTML('beforeend',`<div class="dotDay"><div class="dot ${cl}">${d.getDate()}</div><small>${['日','一','二','三','四','五','六'][d.getDay()]}</small></div>`)}
 const c=metrics(eventsIn(7,0)),p=metrics(eventsIn(7,7));document.getElementById('weekAnxiety').textContent=c.anxiety;document.getElementById('weekCheck').textContent=c.check;document.getElementById('weekDelayRate').textContent=c.delayRate==null?'—':c.delayRate+'%';document.getElementById('weekRecovery').textContent=c.recovery??'—';setDelta('deltaAnxiety',deltaText(c.anxiety,p.anxiety,true));setDelta('deltaCheck',deltaText(c.check,p.check,true));setDelta('deltaDelay',deltaText(c.delayRate,p.delayRate,false,'%'));setDelta('deltaRecovery',deltaText(c.recovery,p.recovery,true,' 分'));
 let msg='資料累積後，這裡會優先看「恢復得更快」而不是要求焦慮歸零。';if(c.recovery!=null&&p.recovery!=null){msg=c.recovery<p.recovery?`這週平均恢復時間比上週短 ${p.recovery-c.recovery} 分鐘。這比單純追求「不焦慮」更值得注意。`:`這週平均恢復時間尚未縮短。先觀察確認行為是否下降，不用把單週波動當成退步。`}document.getElementById('trendMessage').textContent=msg;renderChart();
}
function renderChart(){const el=document.getElementById('recoveryChart');el.innerHTML='';const vals=[];for(let i=6;i>=0;i--){const d=new Date(parseDay(todayKey()));d.setDate(d.getDate()-i);const k=d.toLocaleDateString('sv-SE'),v=avg(doneEvents().filter(x=>x.date===k).map(x=>x.recovery));vals.push({k,v})}const mx=Math.max(30,...vals.map(x=>x.v||0));vals.forEach(x=>{const h=x.v==null?4:Math.max(8,Math.round(x.v/mx*100));el.insertAdjacentHTML('beforeend',`<div class="barwrap"><div class="bar ${x.v==null?'emptybar':''}" style="height:${h}%" title="${x.v==null?'無資料':x.v+' 分鐘'}"></div><div class="barlabel">${x.k.slice(5)}</div></div>`)})}
function renderActiveDelay(){const el=document.getElementById('activeDelayCard'),x=validEvents().find(x=>x.status==='delay'&&x.delayUntil);if(!x){el.classList.add('hidden');return}el.classList.remove('hidden');const left=Math.max(0,Math.ceil((x.delayUntil-Date.now())/60000));el.innerHTML=`<div class="row between"><div><div class="eyebrow">延遲確認進行中</div><h2>${left>0?`還有約 ${left} 分鐘`:'延遲時間已到'}</h2></div><span class="badge">不急著確認</span></div><p>${x.fact?`事實：${esc(x.fact)}`:'你可以帶著不確定繼續現在的生活。'}</p><button class="btn secondary block" onclick="resumeDelay(${x.id})">繼續這次練習</button>`}
function renderRecords(){
 const a=document.getElementById('anxietyList'),xs=[...validEvents()].sort((x,y)=>(y.startedAt||y.id)-(x.startedAt||x.id));if(!xs.length)a.innerHTML='<p>尚無紀錄。</p>';else a.innerHTML=xs.map(x=>`<div class="record"><div class="row between"><div class="recordTitle">${x.date} · ${esc((x.fact||'尚未填寫').slice(0,36))}</div><span class="badge ${x.status==='done'?'':x.status==='delay'?'warm':'gray'}">${x.status==='done'?(x.outcome==='delayed'?'成功延遲':'仍去確認'):x.status==='delay'?'延遲中':'未完成'}</span></div><div class="muted" style="font-size:12px;margin:4px 0">${x.story?`解讀：${esc(x.story.slice(0,55))}`:'尚無解讀'}${Number.isFinite(Number(x.recovery))?` · 恢復 ${x.recovery} 分鐘`:''}</div><div class="row"><button class="btn ghost small" onclick="editAnxiety(${x.id})">查看 / 修改</button><button class="btn danger small" onclick="deleteAnxiety(${x.id})">刪除</button></div></div>`).join('');
 const d=document.getElementById('dailyList'),keys=Object.keys(data.days).filter(k=>data.days[k].morning||data.days[k].evening).sort().reverse();if(!keys.length)d.innerHTML='<p>尚無紀錄。</p>';else d.innerHTML=keys.map(k=>`<div class="record"><div class="row between"><div class="recordTitle">${k}</div><span class="badge ${completedDay(k)?'':'gray'}">${completedDay(k)?'完整':'部分'}</span></div><div class="muted" style="font-size:12