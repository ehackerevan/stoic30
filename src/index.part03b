c.delayUntil||Date.now();openSheet('把確認延後','4 / 5 · 讓不確定性先待著',`<p class="muted">你不需要先把焦慮消除，才可以繼續生活。</p><div class="timer" id="timer">--:--</div><div class="timerSub" id="timerSub"></div><div style="height:12px"></div><button class="btn block" onclick="finishOutcome('delayed')">我成功沒有立刻確認</button><div style="height:8px"></div><button class="btn warm block" onclick="markChecked()">我最後還是去確認了</button>`);function tick(){const ms=until-Date.now(),sec=Math.max(0,Math.ceil(ms/1000)),m=Math.floor(sec/60),s=sec%60;const te=document.getElementById('timer');if(te)te.textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;const sub=document.getElementById('timerSub');if(sub)sub.textContent=ms<=0?'設定的延遲時間已經到了。你已經證明自己可以先不行動。':'倒數只是輔助，不需要一直盯著它。';if(ms<=0&&timerHandle){clearInterval(timerHandle);timerHandle=null}}tick();timerHandle=setInterval(tick,1000)}
function markChecked(){finishOutcome('checked')}
function finishOutcome(outcome){panic.outcome=outcome;panic.status='draft';delete panic.delayUntil;syncPanic();panic5()}
function panic5(){openSheet('回到現在','5 / 5 · 選一個可控制的行動',`<label>接下來我要做什麼？</label><select id="pNext"><option>回去工作</option><option>去運動</option><option>吃飯</option><option>洗澡</option><option>閱讀</option><option>找朋友</option><option>正常與對方相處</option><option>暫時離開手機</option><option>其他</option></select><label>從焦慮出現到「可以繼續生活」，大約用了幾分鐘？</label><input id="pRecovery" type="number" min="0" max="600" inputmode="numeric" placeholder="例如：20"><div class="hint">不需要等到完全不焦慮，只要已經可以回到生活，就算「恢復」。</div><button class="btn block" onclick="finishPanic()">完成這次練習</button>`)}
function finishPanic(){panic.nextAction=pNext.value;panic.recovery=pRecovery.value===''?null:Number(pRecovery.value);panic.finishedAt=Date.now();panic.status='done';syncPanic();closeSheet();toast('完成。現在去做你選擇的下一個行動。')}
function editAnxiety(id){const x=data.anxiety.find(x=>x.id===id);if(!x)return;openSheet('查看 / 修改紀錄',x.date,`<label>客觀事實</label><textarea id="edFact">${esc(x.fact||'')}</textarea><label>我的解讀</label><textarea id="edStory">${esc(x.story||'')}</textarea><label>控制範圍</label><select id="edControl"><option ${x.control==='可控制'?'selected':''}>可控制</option><option ${x.control==='不可控制'?'selected':''}>不可控制</option></select><label>結果</label><select id="edOutcome"><option value="" ${!x.outcome?'selected':''}>未完成</option><option value="delayed" ${x.outcome==='delayed'?'selected':''}>成功延遲</option><option value="checked" ${x.outcome==='checked'?'selected':''}>仍去確認</option></select><label>恢復分鐘</label><input type="number" id="edRecovery" min="0" value="${x.recovery??''}"><label>下一個可控制行動</label><input type="text" id="edNext" value="${esc(x.nextAction||'')}"><button class="btn block" onclick="saveAnxietyEdit(${id})">儲存修改</button>`)}
function saveAnxietyEdit(id){const x=data.anxiety.find(x=>x.id===id);x.fact=edFact.value.trim();x.story=edStory.value.trim();x.control=edControl.value;x.outcome=edOutcome.value||null;x.recovery=edRecovery.value===''?null:Number(edRecovery.value);x.nextAction=edNext.value.trim();x.status=x.outcome?'done':'draft';save();closeSheet();toast('紀錄已更新')}
function deleteAnxiety(id){if(!confirm('刪除這筆焦慮事件紀錄？'))return;data.anxiety=data.anxiety.filter(x=>x.id!==id);save();toast('紀錄已刪除')}
function saveStartDate(){const v=document.getElementById('startDateInput').value;if(!v)return;data.startDate=v;save();toast('開始日已更新')}
function exportJSON(){download(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),`stoic30-backup-${todayKey()}.json`)}
function exportCSV(){const rows=[['date','fact','story','control','outcome','urges','delay_minutes','recovery_minutes','next_action']];doneEvents().forEach(x=>rows.push([x.date,x.fact||'',x.story||'',x.control||'',x.outcome||'',(x.urges||[]).join(' / '),x.delayMinutes||'',x.recovery??'',x.nextAction||'']));const csv=rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n');download(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),`stoic30-anxiety-${todayKey()}.csv`)}
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function restoreJSON(ev){const f=ev.target.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const incoming=normalize(JSON.parse(r.result));if(!confirm('匯入會取代目前這個瀏覽器的 Stoic 30 資料。確定繼續？'))return;data=incoming;save();toast('備份已還原')}catch(e){alert('這個檔案不是有效的 Stoic 30 JSON 備份。')}finally{ev.target.value=''}};r.readAsText(f)}
function resetAll(){if(!confirm('確定永久刪除全部本機資料？這個動作無法復原。'))return;localStorage.removeItem(KEY);localStorage.removeItem(OLD_KEY);data=baseData();save();toast('全部資料已清除')}
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredPrompt=e;document.getElementById('installBtn').classList.remove('hidden');document.getElementById('installHint').classList.add('hidden')});
async function installApp(){if(!deferredPrompt)return;deferredPrompt.prompt();await deferredPrompt.userChoice;deferredPrompt=null;document.getElementById('installBtn').classList.add('hidden')}
if('serviceWorker' in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker.js').catch(()=>{}));
renderAll();
</script>
</body></html>