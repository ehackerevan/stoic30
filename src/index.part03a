px;margin-top:4px">早晨 ${data.days[k].morning?'✓':'—'} · 晚間 ${data.days[k].evening?'✓':'—'}</div></div>`).join('')
}
function openSheet(title,step,body){document.getElementById('sheetTitle').textContent=title;document.getElementById('sheetStep').textContent=step||'';document.getElementById('sheetBody').innerHTML=body;document.getElementById('overlay').classList.add('show');document.querySelector('.sheet').scrollTop=0}
function closeSheet(){document.getElementById('overlay').classList.remove('show');if(timerHandle){clearInterval(timerHandle);timerHandle=null}renderAll()}
function openMorning(){const m=dayRecord().morning||{};openSheet('早晨練習','約 2–3 分鐘',`<label>今天我最在意的是什麼？</label><textarea id="mConcern" placeholder="例如：今天的互動會不會變冷淡？">${esc(m.concern||'')}</textarea><label>今天哪些是我能控制的？</label><textarea id="mControl" placeholder="我的態度、工作、自然互動、是否照顧自己的生活。">${esc(m.control||'')}</textarea><label>哪些不是我能控制的？</label><textarea id="mNoControl" placeholder="對方的感受、是否主動、最後的結果。">${esc(m.noControl||'')}</textarea><label>如果今天結果不如預期，我承受得起嗎？</label><select id="mCapacity"><option ${m.capacity==='是'?'selected':''}>是</option><option ${m.capacity==='有點困難'?'selected':''}>有點困難</option><option ${m.capacity==='現在覺得很難'?'selected':''}>現在覺得很難</option></select><div class="hint">今天只對「可控制」那一欄負責。</div><button class="btn block" onclick="saveMorning()">完成早晨練習</button>`)}
function saveMorning(){dayRecord().morning={concern:mConcern.value.trim(),control:mControl.value.trim(),noControl:mNoControl.value.trim(),capacity:mCapacity.value,at:new Date().toISOString()};save();closeSheet();toast('早晨練習已儲存')}
function openEvening(){const e=dayRecord().evening||{};openSheet('晚間回顧','約 5 分鐘',`<label>① 今天什麼事情觸發了我？</label><textarea id="eTrigger">${esc(e.trigger||'')}</textarea><label>② 我當時怎麼解讀？</label><textarea id="eStory">${esc(e.story||'')}</textarea><label>③ 我有沒有試圖控制不能控制的事情？</label><select id="eControl"><option ${e.overControl==='有'?'selected':''}>有</option><option ${e.overControl==='沒有'?'selected':''}>沒有</option></select><label>④ 今天我做對了什麼？</label><textarea id="eRight" placeholder="例如：我有焦慮，但沒有立刻試探，而是先把工作做完。">${esc(e.didRight||'')}</textarea><div class="checkChoice"><label><input type="checkbox" id="eUnknown" ${e.unknown?'checked':''}> 今天有刻意留下一件「不知道答案也沒關係」的事情</label></div><div class="hint">評分的是你的行動，不是對方今天的反應。</div><button class="btn block" onclick="saveEvening()">完成晚間回顧</button>`)}
function saveEvening(){dayRecord().evening={trigger:eTrigger.value.trim(),story:eStory.value.trim(),overControl:eControl.value,didRight:eRight.value.trim(),unknown:eUnknown.checked,at:new Date().toISOString()};save();closeSheet();toast('晚間回顧已儲存')}
function startPanic(){panic={id:Date.now(),date:todayKey(),startedAt:Date.now(),status:'draft',outcome:null,recovery:null};data.anxiety.push(panic);save(false);panic1()}
function getPanic(){return data.anxiety.find(x=>x.id===panic?.id)}
function syncPanic(){const x=getPanic();if(x)Object.assign(x,panic);save(false)}
function panic1(){openSheet('到底發生了什麼？','1 / 5 · 只寫攝影機拍得到的事',`<p class="muted">避免「她變冷淡了」這類推論，只記錄客觀事件。</p><label>客觀事實</label><textarea id="pFact" placeholder="例如：今天我們只有工作上的互動。">${esc(panic.fact||'')}</textarea><button class="btn block" onclick="panic.fact=pFact.value.trim();syncPanic();panic2()">下一步</button>`)}
function panic2(){openSheet('我的大腦怎麼解讀？','2 / 5 · 把故事與事實拆開',`<label>我現在腦中出現什麼故事？</label><textarea id="pStory" placeholder="例如：她是不是對我沒興趣了？">${esc(panic.story||'')}</textarea><button class="btn block" onclick="panic.story=pStory.value.trim();syncPanic();panic3()">下一步</button>`)}
function panic3(){openSheet('控制二分法','3 / 5 · 這是我的任務嗎？',`<div class="factgrid"><div class="factbox"><b>事實</b><div class="muted" style="margin-top:5px">${esc(panic.fact||'—')}</div></div><div class="factbox"><b>解讀</b><div class="muted" style="margin-top:5px">${esc(panic.story||'—')}</div></div></div><label>你現在想解決的核心問題，可以由你直接控制嗎？</label><div class="grid2"><button class="btn secondary" onclick="panic.control='可控制';syncPanic();panic4()">可以控制</button><button class="btn primary" onclick="panic.control='不可控制';syncPanic();panic4()">不能控制</button></div>`)}
function panic4(){openSheet('先不要立刻確認','4 / 5 · 焦慮不是行動指令',`<div class="hint">${panic.control==='不可控制'?'這不是你現在必須解決的問題。允許答案暫時不存在。':'把焦點放在下一個真正可控制的行動，而不是用確認消除焦慮。'}</div><label>我現在最想做什麼？</label><div class="checkChoice">${['重看聊天紀錄','看對方是否上線','傳訊息試探','問別人對方怎麼想','占卜／尋求另一個答案','重新分析互動'].map(x=>`<label><input type="checkbox" name="urge" value="${x}" ${panic.urges?.includes(x)?'checked':''}> ${x}</label>`).join('')}</div><label>先延後多久？</label><div class="grid2"><button class="btn secondary" onclick="beginDelay(10)">10 分鐘</button><button class="btn secondary" onclick="beginDelay(30)">30 分鐘</button></div><div style="height:8px"></div><button class="btn ghost block" onclick="beginDelay(1440)">延後到明天</button><div style="height:8px"></div><button class="btn warm block" onclick="markChecked()">我仍決定現在去確認</button>`)}
function beginDelay(min){panic.urges=[...document.querySelectorAll('input[name=urge]:checked')].map(x=>x.value);panic.delayMinutes=min;panic.delayUntil=Date.now()+min*60000;panic.status='delay';syncPanic();if(min>=1440){toast('已記錄：把確認延後到明天');closeSheet();return}showDelay()}
function resumeDelay(id){panic=data.anxiety.find(x=>x.id===id);if(!panic)return;showDelay()}
